# ── Database (required) ─────────────────────────────────────────────
# Any PostgreSQL 14+ database. For Supabase use the "Session pooler" or direct
# connection string from Project Settings → Database.
DATABASE_URL=postgres://ilf:ilf@localhost:5432/ilf

# ── Auth ────────────────────────────────────────────────────────────
# Set to "false" after you have created your account to block new sign-ups.
ALLOW_SIGNUP=true

# ── Data providers (configure at least one) ────────────────────────
# OpenStreetMap via Overpass — free, no key. Set to "false" to disable.
OSM_ENABLED=true
# Optional: a different Overpass instance (must allow your usage volume).
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Nominatim is used to geocode city/locality when no Geoapify/Google key is set.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Contact email sent in the User-Agent, required by the OSM usage policies.
OSM_CONTACT_EMAIL=

# Google Places API (New) — https://console.cloud.google.com/ (enable "Places API (New)")
GOOGLE_PLACES_API_KEY=

# Geoapify Places — https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# ── Search tuning (optional) ───────────────────────────────────────
# How many grid tiles a city is split into per side when searching (N×N).
SEARCH_GRID_SIZE=4
# Seconds of work per job step (each HTTP step call / worker tick).
JOB_STEP_SECONDS=20
