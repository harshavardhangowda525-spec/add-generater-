# ── Public site URL (no trailing slash) ─────────────────────────────
# Used for the canonical tag, Open Graph URLs and sitemap.xml.
# Leave empty until the final domain is confirmed: the canonical tag and
# sitemap URLs are then left out instead of pointing at a guessed domain.
VITE_SITE_URL=

# ── Proposal mode ───────────────────────────────────────────────────
# true  = show content still awaiting owner confirmation (training options,
#         listed closing time, demonstration images), each clearly labelled.
#         Use this for the demo shown to the gym owner.
# false = public launch: anything not marked confirmed in
#         src/config/site.ts is hidden.
VITE_PROPOSAL_MODE=true

# ── Supabase (enquiry storage) ──────────────────────────────────────
# Project Settings → API. The anon (public) key is safe in the browser
# ONLY because Row Level Security lets it insert enquiries and nothing else.
# NEVER put the service_role key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
